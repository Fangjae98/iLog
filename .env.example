POSTGRES_USER=여기에_DB계정명
POSTGRES_PASSWORD=여기에_비밀번호
POSTGRES_DB=여기에_DB이름

# JWT 서명 키 (32바이트 이상). 비워 두면 도커의 backend 가 뜨지 않습니다.
#   생성: openssl rand -base64 48
JWT_SECRET=

# 임시 비밀번호 안내 메일을 보낼 Gmail 계정 (AUTH-03).
# MAIL_PASSWORD 는 계정 비밀번호가 아니라 앱 비밀번호(16자)입니다.
#   발급: Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호
# 비워 두어도 서버는 뜹니다. 임시 비밀번호 발급만 실패합니다(500 MAIL_SEND_FAILED).
MAIL_USERNAME=
MAIL_PASSWORD=
